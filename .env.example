# ── Панель управления ────────────────────────────────────────────────────────
CR_HTTP_PORT=8088
CR_ADMIN_USER=admin
# bcrypt-хеш пароля. Сгенерировать: bash scripts/gen-env.sh
CR_ADMIN_PASSWORD_HASH=
# Ключ подписи сессионных cookie (32+ случайных байта в hex)
CR_SECRET_KEY=

# ── Интерфейсы (значения по умолчанию для первого запуска) ───────────────────
CR_WAN_IF=enp2s0
CR_LAN_IF=enp1s0
CR_LAN_ADDRESS=192.168.10.1
CR_LAN_PREFIX=24

# ── Имена контейнеров, которыми управляет controller ─────────────────────────
CR_XRAY_CONTAINER=circle-xray
CR_DNSMASQ_CONTAINER=circle-dnsmasq

# ── Версии ───────────────────────────────────────────────────────────────────
XRAY_VERSION=v26.3.27
